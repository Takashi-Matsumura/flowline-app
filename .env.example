# ローカル LLM（llama.cpp の llama-server、OpenAI 互換）。AI の点検・直す案・業務分掌・流れの読み上げ原稿に使う。
LLAMA_BASE_URL=http://localhost:8080
LLAMA_MODEL=gemma
# トークンが届かない無音がこの時間続いたらアボート（ハング検知）
LLAMA_IDLE_TIMEOUT_MS=120000

# 流れのプレビューの読み上げ（VOICEVOX エンジン）。起動していなければ読み上げなしで再生する。
# 話者はスタイル ID（GET /speakers で確認）。既定 8 = 春日部つむぎ（ノーマル）。
VOICEVOX_BASE_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER=8

# 図の保存先（SQLite）。既定は ./data
# DATA_DIR=./data
